@model SGAT.Web.ViewModels.Usuario.UsuarioEditViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

<form asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">

        <label asp-for="NombreCompleto"
               class="form-label"></label>

        <input asp-for="NombreCompleto"
               class="form-control"
               placeholder="Ejemplo: Supervisor" />

        <span asp-validation-for="NombreCompleto"
              class="text-danger"></span>

    </div>

    <div class="form-check mb-3">

        <input asp-for="Activo"
               class="form-check-input" />

        <label asp-for="Activo"
               class="form-check-label"></label>

        <span asp-validation-for="Activo"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="Rol"
               class="form-label"></label>

        <select asp-for="Rol"
                class="form-select">

            <option value="">
                -- Seleccione un rol --
            </option>

            @foreach (var rol in Model.RolesDisponibles)
            {
                <option value="@rol.Nombre">
                    @rol.Nombre
                </option>
            }

        </select>

        <span asp-validation-for="Rol"
              class="text-danger"></span>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Guardar Cambios
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}