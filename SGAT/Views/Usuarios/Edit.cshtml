@model SGAT.Web.ViewModels.Usuario.UsuarioEditViewModel

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <input asp-for="Usuario.Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Usuario.NombreCompleto"
               class="form-label"></label>

        <input asp-for="Usuario.NombreCompleto"
               class="form-control" placeholder="Ejemplo: Supervisor"
               oninput="this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚüÜñÑ\s]/g, '')" />

        <span asp-validation-for="Usuario.NombreCompleto"
              class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Usuario.Activo"
               class="form-check-input" />

        <label asp-for="Usuario.Activo"
               class="form-check-label"></label>
    </div>

    <div class="mb-3">
        <label asp-for="Usuario.Rol" class="form-label">
            Rol
        </label>

        <select asp-for="Usuario.Rol" class="form-select">
            <option value="">-- Seleccione un rol --</option>

            @foreach (var rol in Model.RolesDisponibles)
            {
                <option value="@rol.Nombre">
                    @rol.Nombre
                </option>
            }
        </select>

        <span asp-validation-for="Usuario.Rol"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar Cambios
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>