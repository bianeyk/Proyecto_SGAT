@model SGAT.Web.ViewModels.Usuario.UsuarioCreateViewModel

@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">
                Crear Usuario
            </h4>

        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">
                @* para proteger el formulario contra ataques CSRF. *@
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>
                <div class="mb-3">

                    <label asp-for="Usuario.NombreCompleto"
                           class="form-label">
                    </label>

                    <input asp-for="Usuario.NombreCompleto"
                           class="form-control" />

                    <span asp-validation-for="Usuario.NombreCompleto"
                          class="text-danger"></span>

                </div>
                <div class="mb-3">

                    <label asp-for="Usuario.Email"
                           class="form-label">
                    </label>

                    <input asp-for="Usuario.Email"
                           class="form-control" />

                    <span asp-validation-for="Usuario.Email"
                          class="text-danger"></span>

                </div>
                <div class="mb-3">

                    <label asp-for="Usuario.Password"
                           class="form-label">
                    </label>

                    <input asp-for="Usuario.Password"
                           class="form-control" />

                    <span asp-validation-for="Usuario.Password"
                          class="text-danger"></span>

                </div>
                <div class="mb-3">

                    <label asp-for="Usuario.ConfirmPassword"
                           class="form-label">
                    </label>

                    <input asp-for="Usuario.ConfirmPassword"
                           class="form-control" />

                    <span asp-validation-for="Usuario.ConfirmPassword"
                          class="text-danger"></span>

                </div>
                <div class="form-check mb-3">

                    <input asp-for="Usuario.Activo"
                           class="form-check-input" />

                    <label asp-for="Usuario.Activo"
                           class="form-check-label">
                    </label>

                </div>
                <div class="mb-3">
                    <label asp-for="Usuario.Rol" class="form-label">
                        Rol
                    </label>

                    <select asp-for="Usuario.Rol" class="form-select">
                        <option value="">-- Seleccione un rol --</option>

                        @foreach (var rol in Model.RolesDisponibles)
                        {
                            <option value="@rol.Nombre">
                                @rol.Nombre
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Usuario.Rol"
                          class="text-danger">
                    </span>
                </div>
                
                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        Guardar

                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancelar

                    </a>

                </div>
            </form>

        </div>

    </div>

</div>
@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
