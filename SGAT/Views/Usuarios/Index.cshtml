@model SGAT.Web.ViewModels.Usuario.UsuarioIndexViewModel

@{
    ViewData["Title"] = "Usuarios";

    var totalUsuarios = Model.TotalUsuarios;
    var totalActivos = Model.Resultado.ActiveCount;
    var totalInactivos = Model.Resultado.InactiveCount;
}

<div class="container mt-4">
    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="fw-bold text-secondary mb-1">
                <i class="bi bi-people-fill me-2"></i>Administración de Usuarios
            </h2>
            <div class="text-muted small">
                <span class="me-3"><i class="bi bi-person-lines-fill me-1"></i>Total: <strong>@totalUsuarios</strong></span>
                <span class="me-3 text-success"><i class="bi bi-check-circle me-1"></i>Activos: <strong>@totalActivos</strong></span>
                <span class="text-danger"><i class="bi bi-dash-circle me-1"></i>Inactivos: <strong>@totalInactivos</strong></span>
            </div>
        </div>
        <div class="d-flex gap-2">

            <a asp-controller="Roles"
               asp-action="Index"
               class="btn btn-success">
                Gestionar Rol
            </a>

            <a asp-action="Create" class="btn btn-primary">
                Nuevo Usuario
            </a>

        </div>
    </div>

    <!-- Mensajes de Notificación -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
        
    }

    <!-- Validaciones de búsqueda -->
    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <!-- Barra de búsqueda y filtros -->
    <div class="card shadow-sm mb-3 border-0">
        <div class="card-body py-3">

            <form asp-action="Index" method="get">

                <input type="hidden" name="Pagina" value="1" />

                <div class="row g-2 align-items-center">

                    <!-- Búsqueda -->
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="Termino"
                                   value="@Model.Filtro.Termino"
                                   maxlength="100"
                                   class="form-control"
                                   placeholder="Buscar por nombre o correo..."
                                   aria-label="Buscar usuario" />
                        </div>
                    </div>

                    <!-- Estado -->
                    <div class="col-md-2">
                        <select name="Activo"
                                class="form-select"
                                aria-label="Estado">

                            <option value="">Todos los estados</option>

                            <option value="true"
                                    selected="@(Model.Filtro.Activo == true)">
                                Activo
                            </option>

                            <option value="false"
                                    selected="@(Model.Filtro.Activo == false)">
                                Inactivo
                            </option>

                        </select>
                    </div>

                    <!-- Roles -->
                    <div class="col-md-2">
                        <select name="Rol"
                                class="form-select"
                                aria-label="Rol">

                            <option value="">Todos los roles</option>

                            @foreach (var rol in Model.RolesDisponibles)
                            {
                                <option value="@rol.Id"
                                        selected="@(Model.Filtro.Rol == rol.Id)">
                                    @rol.Nombre
                                </option>
                            }

                        </select>
                    </div>

                    <!-- Tamaño de página -->
                    <div class="col-md-2">
                        <select name="TamanoPagina"
                                class="form-select"
                                aria-label="Registros por página">

                            @foreach (var cantidad in new[] { 10, 25, 50, 100 })
                            {
                                <option value="@cantidad"
                                        selected="@(Model.Filtro.TamanoPagina == cantidad)">
                                    @cantidad registros
                                </option>
                            }

                        </select>
                    </div>

                    <!-- Acciones -->
                    <div class="col-md-2 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary"
                                title="Buscar">
                            <i class="bi bi-search"></i>
                            Buscar
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary"
                           title="Limpiar filtros"
                           aria-label="Limpiar filtros">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>

                    </div>

                </div>
            </form>
        </div>
    </div>
    <!-- Tabla de Usuarios -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle mb-0" id="tablaUsuarios">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Correo</th>
                    <th scope="col" class="text-center">Estado</th>
                    <th scope="col">Roles</th>
                    <th scope="col" class="text-center" style="width: 220px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Resultado.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            <i class="bi bi-people-fill display-6 d-block mb-2"></i>
                            @if (ViewData.ModelState.IsValid)
                            {
                                <span>No se encontraron usuarios que coincidan con los filtros.</span>
                            }
                            else
                            {
                                <span>No se pudo realizar la búsqueda.</span>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Resultado.Items)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar-inicial rounded-circle bg-secondary-subtle text-secondary d-inline-flex align-items-center justify-content-center">
                                        @(item.NombreCompleto.Length > 0 ? item.NombreCompleto.Substring(0, 1).ToUpper() : "?")
                                    </span>
                                    @item.NombreCompleto
                                </div>
                            </td>
                            <td>@item.Email</td>
                            <td class="text-center">
                                @if (item.Activo)
                                {
                                    <span class="badge rounded-pill bg-success-subtle text-success border border-success">
                                        <i class="bi bi-check-circle me-1"></i>Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger">
                                        <i class="bi bi-dash-circle me-1"></i>Inactivo
                                    </span>
                                }
                            </td>
                            <td>
                                @foreach (var rol in item.Roles)
                                {
                                    var color = rol switch
                                    {
                                        "Administrador" => "bg-danger",
                                        "Gerente" => "bg-primary",
                                        "Tecnico" => "bg-success",
                                        _ => "bg-secondary"
                                    };
                                    <span class="badge @color me-1">@rol</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <!-- Ver Detalles -->
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Ver Detalles" data-bs-toggle="tooltip">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <!-- Editar -->
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Editar" data-bs-toggle="tooltip">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <!-- Cambiar Estado -->
                                    @if (item.Activo)
                                    {
                                        <form asp-action="Inactivar" asp-route-id="@item.Id" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Inactivar" data-bs-toggle="tooltip" onclick="return confirm('¿Desea inactivar este usuario?')">
                                                <i class="bi bi-dash-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activar" asp-route-id="@item.Id" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success btn-sm" title="Activar" data-bs-toggle="tooltip" onclick="return confirm('¿Desea activar este usuario?')">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    @if (ViewData.ModelState.IsValid &&
         Model.Resultado.TotalCount > 0)
    {
        <div class="d-flex flex-wrap
            justify-content-between
            align-items-center mt-3 gap-2">

            <!-- Información de resultados -->
            <div class="text-muted small">
                Mostrando @Model.Resultado.Items.Count
                de @Model.Resultado.TotalCount resultados.
            </div>

            <!-- Navegación -->
            <nav aria-label="Paginación de usuarios">

                <div class="d-flex align-items-center gap-2">

                    @if (Model.TienePaginaAnterior)
                    {
                        <a asp-action="Index"
                           asp-route-Termino="@Model.Filtro.Termino"
                           asp-route-Activo="@Model.Filtro.Activo"
                           asp-route-Rol="@Model.Filtro.Rol"
                           asp-route-Pagina="@(Model.Filtro.Pagina - 1)"
                           asp-route-TamanoPagina="@Model.Filtro.TamanoPagina"
                           class="btn btn-outline-primary btn-sm">

                            <i class="bi bi-chevron-left"></i>
                            Anterior
                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                disabled>
                            Anterior
                        </button>
                    }

                    <span class="small fw-semibold">
                        Página @Model.Filtro.Pagina
                        de @Model.TotalPaginas
                    </span>

                    @if (Model.TienePaginaSiguiente)
                    {
                        <a asp-action="Index"
                           asp-route-Termino="@Model.Filtro.Termino"
                           asp-route-Activo="@Model.Filtro.Activo"
                           asp-route-Rol="@Model.Filtro.Rol"
                           asp-route-Pagina="@(Model.Filtro.Pagina + 1)"
                           asp-route-TamanoPagina="@Model.Filtro.TamanoPagina"
                           class="btn btn-outline-primary btn-sm">

                            Siguiente
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                disabled>
                            Siguiente
                        </button>
                    }

                </div>

            </nav>
        </div>
    }
</div>

<style>
    .avatar-inicial {
        width: 32px;
        height: 32px;
        font-size: 0.85rem;
        font-weight: 600;
        flex-shrink: 0;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const tooltipTriggerList =
                document.querySelectorAll('[data-bs-toggle="tooltip"]');

            tooltipTriggerList.forEach(function (el) {
                new bootstrap.Tooltip(el);
            });

        });
    </script>
}

