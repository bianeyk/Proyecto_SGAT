@model SGAT.Web.ViewModels.CategoriaProducto.CategoriaProductoIndexViewModel

@{
    ViewData["Title"] = "Categorías";
}

@section Styles {
    <link rel="stylesheet" href="~/css/categorias-producto.css" asp-append-version="true" />
}

<div class="container sg-categorias mt-4 mb-5">
    @* Encabezado *@
    <div class="sg-header">
        <div>
            <span class="sg-eyebrow"><i class="bi bi-collection"></i> Catálogo</span>
            <h1 class="sg-titulo">Categorías</h1>
            <p class="sg-sub">
                @if (Model.HayBusqueda)
                {
                    <span>@Model.Total @(Model.Total == 1 ? "resultado" : "resultados") para "@Model.Termino"</span>
                }
                else
                {
                    <span>Administra las categorías disponibles para los productos del inventario.</span>
                }
            </p>
        </div>
        <a asp-action="Create" class="btn sg-btn-primario">
            <i class="bi bi-plus-lg"></i> Nueva categoría
        </a>
    </div>

    @* Tarjetas de resumen *@
    <div class="sg-stats">
        <div class="sg-stat">
            <div class="sg-stat-ico"><i class="bi bi-collection"></i></div>
            <div>
                <div class="sg-stat-num">@Model.Total</div>
                <div class="sg-stat-lbl">Total de categorías</div>
            </div>
        </div>
        <div class="sg-stat">
            <div class="sg-stat-ico is-ok"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="sg-stat-num">@Model.TotalActivas</div>
                <div class="sg-stat-lbl">Activas</div>
            </div>
        </div>
        <div class="sg-stat">
            <div class="sg-stat-ico is-off"><i class="bi bi-slash-circle"></i></div>
            <div>
                <div class="sg-stat-num">@Model.TotalInactivas</div>
                <div class="sg-stat-lbl">Inactivas</div>
            </div>
        </div>
    </div>

    @* Mensajes *@
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success sg-alerta d-flex align-items-center gap-2 alert-dismissible fade show mt-3 mb-0" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger sg-alerta d-flex align-items-center gap-2 alert-dismissible fade show mt-3 mb-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @* Barra de herramientas *@
    <div class="sg-toolbar">
        <form asp-action="Index" method="get" class="sg-buscador" role="search">
            <i class="bi bi-search"></i>
            <input type="search" name="termino" value="@Model.Termino"
                   placeholder="Buscar por nombre o descripción"
                   aria-label="Buscar categorías" />
            @if (Model.HayBusqueda)
            {
                <a asp-action="Index" class="sg-limpiar" title="Limpiar búsqueda" aria-label="Limpiar búsqueda">
                    <i class="bi bi-x-circle-fill"></i>
                </a>
            }
            <button type="submit" class="sg-buscar">Buscar</button>
        </form>

        @if (Model.Total > 0)
        {
            <div class="sg-segmentos" role="group" aria-label="Filtrar por estado" id="filtroEstado">
                <button type="button" data-filtro="todos" aria-pressed="true">
                    Todas <span class="sg-cuenta">@Model.Total</span>
                </button>
                <button type="button" data-filtro="activo" aria-pressed="false">
                    Activas <span class="sg-cuenta">@Model.TotalActivas</span>
                </button>
                <button type="button" data-filtro="inactivo" aria-pressed="false">
                    Inactivas <span class="sg-cuenta">@Model.TotalInactivas</span>
                </button>
            </div>
        }
    </div>

    @if (!Model.Categorias.Any())
    {
        <div class="sg-panel sg-vacio">
            <div class="sg-vacio-ico">
                <i class="bi @(Model.HayBusqueda ? "bi-search" : "bi-collection")"></i>
            </div>
            @if (Model.HayBusqueda)
            {
                <h2>Sin resultados para "@Model.Termino"</h2>
                <p>Revisa que el nombre esté bien escrito o prueba con otro dato.</p>
                <a asp-action="Index" class="btn btn-outline-secondary">Ver todas las categorías</a>
            }
            else
            {
                <h2>Aún no hay categorías</h2>
                <p>Crea la primera para poder clasificar los productos del inventario.</p>
                <a asp-action="Create" class="btn sg-btn-primario">
                    <i class="bi bi-plus-lg"></i> Nueva categoría
                </a>
            }
        </div>
    }
    else
    {
        <div class="sg-panel">
            <div class="table-responsive">
                <table class="sg-tabla" id="tablaCategorias">
                    <thead>
                        <tr>
                            <th>Categoría</th>
                            <th>Estado</th>
                            <th class="text-end"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var categoria in Model.Categorias)
                        {
                            <tr class="@(categoria.Activo ? "" : "sg-inactiva")" data-estado="@(categoria.Activo ? "activo" : "inactivo")">
                                <td>
                                    <span class="sg-nombre d-block">@categoria.Nombre</span>
                                    @if (string.IsNullOrWhiteSpace(categoria.Descripcion))
                                    {
                                        <span class="sg-vacio-dato sg-doc">Sin descripción</span>
                                    }
                                    else
                                    {
                                        <span class="sg-doc">@categoria.Descripcion</span>
                                    }
                                </td>
                                <td>
                                    <span class="sg-estado @(categoria.Activo ? "activo" : "inactivo")">
                                        @(categoria.Activo ? "Activa" : "Inactiva")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="sg-acciones">
                                        <a asp-action="Edit" asp-route-id="@categoria.IdCategoriaProducto" class="sg-accion sg-accion-editar">
                                            <i class="bi bi-pencil"></i> <span>Editar</span>
                                        </a>

                                        @if (categoria.Activo)
                                        {
                                            <form asp-action="ActivarDesactivar" asp-route-id="@categoria.IdCategoriaProducto" method="post" class="sg-accion-form">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="sg-accion sg-accion-baja"
                                                        onclick="return confirm('¿Dar de baja esta categoría? Los productos que la usan conservarán el dato, pero no aparecerá en los desplegables.');">
                                                    <i class="bi bi-slash-circle"></i> <span>Dar de baja</span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="ActivarDesactivar" asp-route-id="@categoria.IdCategoriaProducto" method="post" class="sg-accion-form">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="sg-accion sg-accion-reactivar">
                                                    <i class="bi bi-arrow-counterclockwise"></i> <span>Reactivar</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="sg-vacio d-none" id="sinFiltro" style="padding: 2.5rem 1.5rem;">
                <h2>No hay categorías en este estado</h2>
                <p class="mb-0">Cambia el filtro para ver el resto.</p>
            </div>

            <div class="sg-pie" id="pieTabla" aria-live="polite">
                Mostrando <strong id="visibles">@Model.Total</strong> de @Model.Total @(Model.Total == 1 ? "categoría" : "categorías")
            </div>
        </div>
    }

    @if (Model.TotalPaginas > 1)
    {
        <nav class="mt-3" aria-label="Paginación de categorías">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.HayPaginaAnterior ? "" : "disabled")">
                    <a class="page-link" asp-action="Index"
                       asp-route-termino="@Model.Termino"
                       asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Página @Model.PaginaActual de @Model.TotalPaginas</span>
                </li>
                <li class="page-item @(Model.HayPaginaSiguiente ? "" : "disabled")">
                    <a class="page-link" asp-action="Index"
                       asp-route-termino="@Model.Termino"
                       asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var grupo = document.getElementById('filtroEstado');
            var tabla = document.getElementById('tablaCategorias');
            if (!grupo || !tabla) return;

            var filas = tabla.querySelectorAll('tbody tr');
            var contador = document.getElementById('visibles');
            var sinFiltro = document.getElementById('sinFiltro');
            var contenedorTabla = tabla.closest('.table-responsive');

            grupo.addEventListener('click', function (e) {
                var boton = e.target.closest('button[data-filtro]');
                if (!boton) return;

                grupo.querySelectorAll('button').forEach(function (b) {
                    b.setAttribute('aria-pressed', b === boton ? 'true' : 'false');
                });

                var filtro = boton.dataset.filtro, visibles = 0;
                filas.forEach(function (fila) {
                    var mostrar = filtro === 'todos' || fila.dataset.estado === filtro;
                    fila.hidden = !mostrar;
                    if (mostrar) visibles++;
                });

                contador.textContent = visibles;
                contenedorTabla.classList.toggle('d-none', visibles === 0);
                sinFiltro.classList.toggle('d-none', visibles !== 0);
            });
        })();
    </script>
}
