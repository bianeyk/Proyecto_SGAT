@model SGAT.Web.ViewModels.Producto.ProductoIndexViewModel

@{
    ViewData["Title"] = "Productos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
}

<div class="container sg-productos mt-4 mb-5">
    @* Encabezado *@
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="sg-titulo">Productos</h1>
            <p class="sg-sub">
                @if (Model.HayBusqueda)
                {
                    <span>@Model.Total @(Model.Total == 1 ? "resultado" : "resultados") para “@Model.Termino”</span>
                }
                else
                {
                    <span>Consulta, edita y administra los productos del inventario.</span>
                }
            </p>
        </div>
        @if (Model.Total > 0 || Model.HayBusqueda)
        {
            <a asp-action="Create" class="btn sg-btn-primario d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i> Crear producto
            </a>
        }
    </div>

    @* Mensajes *@
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success sg-alerta d-flex align-items-center gap-2 alert-dismissible fade show mt-3 mb-0" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger sg-alerta d-flex align-items-center gap-2 alert-dismissible fade show mt-3 mb-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @* Barra de herramientas *@
    <div class="sg-toolbar">
        <form asp-action="Index" method="get" class="sg-buscador" role="search">
            <i class="bi bi-search"></i>
            <input type="search" name="termino" value="@Model.Termino"
                   placeholder="Buscar por código, nombre, categoría o marca"
                   aria-label="Buscar productos" />
            @if (Model.HayBusqueda)
            {
                <a asp-action="Index" class="sg-limpiar" title="Limpiar búsqueda" aria-label="Limpiar búsqueda">
                    <i class="bi bi-x-circle-fill"></i>
                </a>
            }
            <button type="submit" class="sg-buscar">Buscar</button>
        </form>

        @if (Model.Total > 0)
        {
            <div class="sg-segmentos" role="group" aria-label="Filtrar por estado" id="filtroEstado">
                <button type="button" data-filtro="todos" aria-pressed="true">
                    Todos <span class="sg-cuenta">@Model.Total</span>
                </button>
                <button type="button" data-filtro="activo" aria-pressed="false">
                    Activos <span class="sg-cuenta">@Model.TotalActivos</span>
                </button>
                <button type="button" data-filtro="inactivo" aria-pressed="false">
                    Inactivos <span class="sg-cuenta">@Model.TotalInactivos</span>
                </button>
                <button type="button" data-filtro="stockbajo" aria-pressed="false">
                    Stock bajo <span class="sg-cuenta">@Model.TotalStockBajo</span>
                </button>
            </div>
        }
    </div>

    @if (!Model.Productos.Any())
    {
        <div class="sg-panel sg-vacio">
            <div class="sg-vacio-ico">
                <i class="bi @(Model.HayBusqueda ? "bi-search" : "bi-box-seam")"></i>
            </div>
            @if (Model.HayBusqueda)
            {
                <h2>Sin resultados para “@Model.Termino”</h2>
                <p>Revisa que el código o el nombre estén bien escritos, o prueba con otro dato.</p>
                <a asp-action="Index" class="btn btn-outline-secondary">Ver todos los productos</a>
            }
            else
            {
                <h2>Aún no hay productos</h2>
                <p>Crea el primero para empezar a gestionar el inventario.</p>
                <a asp-action="Create" class="btn sg-btn-primario d-inline-flex align-items-center gap-2">
                    <i class="bi bi-plus-lg"></i> Crear producto
                </a>
            }
        </div>
    }
    else
    {
        <div class="sg-panel">
            <div class="table-responsive">
                <table class="sg-tabla" id="tablaProductos">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Producto</th>
                            <th class="d-none d-md-table-cell">Categoría</th>
                            <th class="d-none d-lg-table-cell">Marca</th>
                            <th class="d-none d-xl-table-cell">Condición</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th>Estado</th>
                            <th class="text-end"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Productos)
                        {
                            <tr class="@(p.Activo ? "" : "sg-inactiva")" data-estado="@(p.Activo ? "activo" : "inactivo")" data-stockbajo="@(p.StockBajo ? "1" : "0")">
                                <td class="sg-doc">@(string.IsNullOrWhiteSpace(p.Codigo) ? "—" : p.Codigo)</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@p.IdProducto" class="sg-nombre d-block">@p.Nombre</a>
                                    @if (p.PrecioDescuento.HasValue)
                                    {
                                        <span class="sg-doc">Desc. @p.PrecioDescuento.Value.ToString("C")</span>
                                    }
                                </td>
                                <td class="d-none d-md-table-cell sg-dato">@(string.IsNullOrWhiteSpace(p.Categoria) ? "—" : p.Categoria)</td>
                                <td class="d-none d-lg-table-cell sg-dato">@(string.IsNullOrWhiteSpace(p.Marca) ? "—" : p.Marca)</td>
                                <td class="d-none d-xl-table-cell sg-dato">@p.Condicion</td>
                                <td class="sg-precio">@p.PrecioVenta.ToString("C")</td>
                                <td class="sg-dato">
                                    @p.StockActual
                                    @if (p.StockBajo)
                                    {
                                        <i class="bi bi-exclamation-triangle-fill text-warning ms-1" title="Stock bajo (mín. @p.StockMinimo)"></i>
                                    }
                                </td>
                                <td>
                                    <span class="sg-estado @(p.Activo ? "activo" : "inactivo")">
                                        @(p.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <div class="sg-acciones">
                                        <a asp-action="Details" asp-route-id="@p.IdProducto" class="sg-ver">Ver</a>
                                        <div class="dropdown">
                                            <button type="button" class="sg-menu-btn" data-bs-toggle="dropdown"
                                                    aria-expanded="false" aria-label="Más acciones para @p.Nombre">
                                                <i class="bi bi-three-dots"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@p.IdProducto">
                                                        <i class="bi bi-pencil"></i> Editar
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider" /></li>
                                                @if (p.Activo)
                                                {
                                                    <li>
                                                        <form asp-action="ActivarDesactivar" asp-route-id="@p.IdProducto" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item peligro"
                                                                    onclick="return confirm('¿Dar de baja este producto?');">
                                                                <i class="bi bi-slash-circle"></i> Dar de baja
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li>
                                                        <form asp-action="ActivarDesactivar" asp-route-id="@p.IdProducto" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item">
                                                                <i class="bi bi-check-circle"></i> Reactivar
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="sg-vacio d-none" id="sinFiltro" style="padding: 2.5rem 1.5rem;">
                <h2>No hay productos en este estado</h2>
                <p class="mb-0">Cambia el filtro para ver el resto.</p>
            </div>

            <div class="sg-pie" id="pieTabla" aria-live="polite">
                Mostrando <strong id="visibles">@Model.Total</strong> de @Model.Total @(Model.Total == 1 ? "producto" : "productos")
            </div>
        </div>
    }

    @if (Model.TotalPaginas > 1)
    {
        <nav class="mt-3" aria-label="Paginación de productos">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.HayPaginaAnterior ? "" : "disabled")">
                    <a class="page-link" asp-action="Index"
                       asp-route-termino="@Model.Termino"
                       asp-route-filtro="@Model.Filtro"
                       asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Página @Model.PaginaActual de @Model.TotalPaginas</span>
                </li>
                <li class="page-item @(Model.HayPaginaSiguiente ? "" : "disabled")">
                    <a class="page-link" asp-action="Index"
                       asp-route-termino="@Model.Termino"
                       asp-route-filtro="@Model.Filtro"
                       asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>

<script>
    (function () {
        var grupo = document.getElementById('filtroEstado');
        var tabla = document.getElementById('tablaProductos');
        if (!grupo || !tabla) return;

        var filas = tabla.querySelectorAll('tbody tr');
        var contador = document.getElementById('visibles');
        var sinFiltro = document.getElementById('sinFiltro');
        var contenedorTabla = tabla.closest('.table-responsive');

        grupo.addEventListener('click', function (e) {
            var boton = e.target.closest('button[data-filtro]');
            if (!boton) return;

            grupo.querySelectorAll('button').forEach(function (b) {
                b.setAttribute('aria-pressed', b === boton ? 'true' : 'false');
            });

            var filtro = boton.dataset.filtro, visibles = 0;
            filas.forEach(function (fila) {
                var estado = fila.dataset.estado || '';
                var esStockBajo = fila.dataset.stockbajo === '1';
                var mostrar = filtro === 'todos'
                    || (filtro === 'activo' && estado === 'activo')
                    || (filtro === 'inactivo' && estado === 'inactivo')
                    || (filtro === 'stockbajo' && esStockBajo);
                fila.hidden = !mostrar;
                if (mostrar) visibles++;
            });

            contador.textContent = visibles;
            contenedorTabla.classList.toggle('d-none', visibles === 0);
            sinFiltro.classList.toggle('d-none', visibles !== 0);
        });
    })();
</script>
