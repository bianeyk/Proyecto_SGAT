@model SGAT.Web.ViewModels.Equipo.CategoriaDispositivoViewModel
@{
    var editando = Model.IdCategoriaDispositivo > 0;
    ViewData["Title"] = editando ? "Editar categoría de dispositivo" : "Nueva categoría de dispositivo";
}
<div class="container py-4" style="max-width: 760px">
    <a asp-action="Index" class="text-decoration-none">← Categorías de dispositivos</a>
    <h1 class="mt-3">@ViewData["Title"]</h1>
    <form asp-action="@(editando ? "Edit" : "Create")" asp-route-id="@(editando ? Model.IdCategoriaDispositivo : (int?)null)" method="post" class="card shadow-sm mt-4">
        <div class="card-body p-4">
            <input asp-for="IdCategoriaDispositivo" type="hidden" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" maxlength="100" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" class="form-control" maxlength="255" rows="3"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
            <div class="form-check"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label">Activa</label></div>
        </div>
        <div class="card-footer d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary">Guardar categoría de dispositivo</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
