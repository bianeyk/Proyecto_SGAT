@model SGAT.Application.DTOs.Tecnico.DetalleOrdenTecnicoDto

@{
    ViewData["Title"] = $"Orden {Model.NumeroOrden} - Ficha Técnica";
}

<div class="container py-4">

    <!-- Navegación y Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <a href="/Tecnico" class="btn btn-outline-secondary btn-sm mb-2">
                <i class="bi bi-arrow-left me-1"></i> Volver al Taller
            </a>
            <h2 class="fw-bold text-dark m-0">
                <i class="bi bi-clipboard2-pulse text-primary me-2"></i>Ficha Técnica: @Model.NumeroOrden
            </h2>
            <div class="text-muted small mt-1">
                Ingresado el <strong>@Model.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</strong> 
                | Creado por: <strong>@Model.UsuarioCreaNombre</strong>
                | Prioridad: 
                @switch (Model.Prioridad)
                {
                    case "ALTA":
                        <span class="badge bg-danger">ALTA</span>
                        break;
                    case "BAJA":
                        <span class="badge bg-info text-dark">BAJA</span>
                        break;
                    default:
                        <span class="badge bg-warning text-dark">MEDIA</span>
                        break;
                }
            </div>
        </div>

        <div class="text-md-end">
            <div class="d-flex gap-2 align-items-center">
                <div>
                    <span class="small text-muted d-block">Estado BD</span>
                    <span class="badge bg-light text-secondary border px-3 py-2">@Model.EstadoServicioNombre</span>
                </div>
                <div>
                    <span class="small text-muted d-block">Flujo Técnico</span>
                    @switch (Model.Estado)
                    {
                        case "PendienteRevision":
                            <span class="badge bg-secondary fs-6 px-3 py-2">Pendiente de Revisión</span>
                            break;
                        case "EnDiagnostico":
                            <span class="badge bg-info text-dark fs-6 px-3 py-2">En Diagnóstico</span>
                            break;
                        case "EsperandoRepuestos":
                            <span class="badge bg-warning text-dark fs-6 px-3 py-2">Esperando Repuestos</span>
                            break;
                        case "EnReparacion":
                            <span class="badge bg-primary fs-6 px-3 py-2">En Reparación</span>
                            break;
                        case "Finalizado":
                            <span class="badge bg-success fs-6 px-3 py-2">Finalizado</span>
                            break;
                        case "NoReparable":
                            <span class="badge bg-danger fs-6 px-3 py-2">No Reparable</span>
                            break;
                        default:
                            <span class="badge bg-light text-dark border fs-6 px-3 py-2">@Model.Estado</span>
                            break;
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Tarjetas de Resumen Financiero y Fechas -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-primary">
                <span class="text-muted small fw-semibold">Costo Total Orden</span>
                <h4 class="fw-bold mb-0 text-dark">$ @Model.CostoTotal.ToString("N2")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                <span class="text-muted small fw-semibold">Abono Inicial</span>
                <h4 class="fw-bold mb-0 text-success">$ @Model.Abono.ToString("N2")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                <span class="text-muted small fw-semibold">Saldo Pendiente</span>
                <h4 class="fw-bold mb-0 text-warning">$ @Model.SaldoPendiente.ToString("N2")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-secondary">
                <span class="text-muted small fw-semibold">Fecha Prometida</span>
                <h5 class="fw-bold mb-0 text-secondary">
                    @(Model.FechaPrometida.HasValue ? Model.FechaPrometida.Value.ToString("dd/MM/yyyy") : "No acordada")
                </h5>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Columna Izquierda: Cliente y Equipo -->
        <div class="col-lg-4">

            <!-- Tarjeta Cliente -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold text-secondary m-0">
                        <i class="bi bi-person me-2 text-primary"></i>Datos del Cliente
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="mb-2">
                        <span class="text-muted small d-block">Nombre:</span>
                        <strong class="text-dark">@Model.Cliente.Nombre</strong>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small d-block">Documento:</span>
                        <span>@(string.IsNullOrWhiteSpace(Model.Cliente.NumDoc) ? "Sin documento" : Model.Cliente.NumDoc)</span>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small d-block">Teléfono / Celular:</span>
                        <span><i class="bi bi-telephone me-1 text-muted"></i>@Model.Cliente.Telefono</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Cliente.Email))
                    {
                        <div class="mb-2">
                            <span class="text-muted small d-block">Correo Electrónico:</span>
                            <span><i class="bi bi-envelope me-1 text-muted"></i>@Model.Cliente.Email</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Cliente.Direccion))
                    {
                        <div class="mb-2">
                            <span class="text-muted small d-block">Dirección:</span>
                            <span class="small text-secondary"><i class="bi bi-geo-alt me-1 text-muted"></i>@Model.Cliente.Direccion</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Tarjeta Equipo -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold text-secondary m-0">
                        <i class="bi bi-laptop me-2 text-primary"></i>Datos del Dispositivo
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="mb-2">
                        <span class="text-muted small d-block">Categoría:</span>
                        <strong class="text-dark">@Model.Equipo.Categoria</strong>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small d-block">Marca y Modelo:</span>
                        <span>@Model.Equipo.Marca - <strong>@Model.Equipo.Modelo</strong></span>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small d-block">Número de Serie:</span>
                        <code>@(string.IsNullOrWhiteSpace(Model.Equipo.Serial) ? "N/A" : Model.Equipo.Serial)</code>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Equipo.Descripcion))
                    {
                        <div class="mb-2">
                            <span class="text-muted small d-block">Descripción / Estado Físico:</span>
                            <span class="small text-secondary">@Model.Equipo.Descripcion</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Diagnóstico / Observaciones iniciales de recepción -->
            <div class="card border-0 shadow-sm rounded-4 bg-light mb-4">
                <div class="card-body p-3">
                    <h6 class="fw-bold text-secondary small mb-2">
                        <i class="bi bi-info-circle me-1 text-primary"></i>Recepción de la Orden
                    </h6>
                    @if (!string.IsNullOrWhiteSpace(Model.DiagnosticoInicial))
                    {
                        <div class="mb-2">
                            <span class="text-muted small d-block">Diagnóstico Previo:</span>
                            <p class="small text-dark mb-0">@Model.DiagnosticoInicial</p>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                    {
                        <div>
                            <span class="text-muted small d-block">Observaciones de Ingreso:</span>
                            <p class="small text-muted mb-0">@Model.Observaciones</p>
                        </div>
                    }
                    @if (Model.FechaCierre.HasValue)
                    {
                        <div class="mt-2 pt-2 border-top">
                            <span class="text-muted small d-block">Fecha de Cierre Técnico:</span>
                            <strong class="text-success small">@Model.FechaCierre.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- Columna Derecha: Diagnóstico, Servicios, Repuestos y Bitácora -->
        <div class="col-lg-8">

            <!-- Diagnóstico Técnico Actual -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-secondary m-0">
                        <i class="bi bi-search me-2 text-warning"></i>Diagnóstico Técnico
                    </h6>
                    @if (Model.DiagnosticoActual != null)
                    {
                        <span class="small text-muted">
                            Atendido por: <strong>@Model.DiagnosticoActual.TecnicoNombre</strong>
                        </span>
                    }
                </div>
                <div class="card-body p-4">
                    @if (Model.DiagnosticoActual == null)
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-file-earmark-medical fs-1 d-block mb-2 text-secondary"></i>
                            Aún no se ha registrado un diagnóstico técnico formal para esta orden.
                            <div class="mt-3">
                                <a href="/Tecnico" class="btn btn-warning btn-sm fw-bold">
                                    <i class="bi bi-plus-circle me-1"></i> Ir al Tablero para Diagnosticar
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @if (!string.IsNullOrWhiteSpace(Model.DiagnosticoActual.FallaReportada))
                            {
                                <div class="col-12">
                                    <span class="text-muted small d-block">Falla Reportada:</span>
                                    <p class="fw-semibold text-danger mb-2">@Model.DiagnosticoActual.FallaReportada</p>
                                </div>
                            }

                            <div class="col-12">
                                <span class="text-muted small d-block">Diagnóstico Detallado del Técnico:</span>
                                <div class="p-3 bg-light rounded-3 text-secondary">
                                    @Model.DiagnosticoActual.DiagnosticoDetallado
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.DiagnosticoActual.SolucionAplicada))
                            {
                                <div class="col-12">
                                    <span class="text-muted small d-block">Solución Aplicada:</span>
                                    <div class="p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 text-success fw-semibold">
                                        @Model.DiagnosticoActual.SolucionAplicada
                                    </div>
                                </div>
                            }

                            <div class="col-md-6">
                                <span class="text-muted small d-block">¿Requiere Repuestos?:</span>
                                <strong>@(Model.DiagnosticoActual.RequiereRepuestos ? "Sí" : "No")</strong>
                                @if (Model.DiagnosticoActual.RequiereRepuestos && !string.IsNullOrWhiteSpace(Model.DiagnosticoActual.RepuestosSugeridos))
                                {
                                    <div class="small text-muted mt-1">
                                        Repuestos Sugeridos: <em>@Model.DiagnosticoActual.RepuestosSugeridos</em>
                                    </div>
                                }
                            </div>

                            <div class="col-md-6">
                                <span class="text-muted small d-block">Costo Mano de Obra:</span>
                                <h5 class="fw-bold text-dark mb-0">$ @Model.DiagnosticoActual.CostoManoDeObra.ToString("N2")</h5>
                            </div>

                            <div class="col-12 small text-muted border-top pt-2">
                                Inicio: @Model.DiagnosticoActual.FechaInicio.ToString("dd/MM/yyyy HH:mm")
                                @if (Model.DiagnosticoActual.FechaFinalizacion.HasValue)
                                {
                                    <span> | Finalización: @Model.DiagnosticoActual.FechaFinalizacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Servicios y Mano de Obra Aplicados (OrdenServicioDetalles) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-secondary m-0">
                        <i class="bi bi-gear-wide-connected me-2 text-primary"></i>Servicios y Mano de Obra (@Model.ServiciosAplicados.Count)
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (!Model.ServiciosAplicados.Any())
                    {
                        <p class="text-muted small text-center py-3 m-0">No hay servicios o procedimientos registrados para esta orden.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th class="ps-3">Servicio</th>
                                        <th>Descripción</th>
                                        <th>Observación</th>
                                        <th>Registrado Por</th>
                                        <th class="pe-3 text-end">Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model.ServiciosAplicados)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold">@s.ServicioNombre</td>
                                            <td class="small">@s.Descripcion</td>
                                            <td class="small text-muted">@(string.IsNullOrWhiteSpace(s.Observacion) ? "-" : s.Observacion)</td>
                                            <td class="small">@s.UsuarioCrea</td>
                                            <td class="pe-3 text-end small text-muted">@s.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Repuestos y Materiales de Inventario (OrdenServicioDetalleProductos) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-secondary m-0">
                        <i class="bi bi-cpu me-2 text-warning"></i>Repuestos y Materiales de Inventario (@Model.RepuestosAplicados.Count)
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (!Model.RepuestosAplicados.Any())
                    {
                        <p class="text-muted small text-center py-3 m-0">No se han asignado repuestos de inventario a esta orden de servicio.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th class="ps-3">Producto / Repuesto</th>
                                        <th class="text-center">Cantidad</th>
                                        <th class="text-end">Precio Unit.</th>
                                        <th class="text-end">Subtotal</th>
                                        <th class="pe-3 text-center">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.RepuestosAplicados)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold">@r.ProductoNombre</td>
                                            <td class="text-center">@r.Cantidad.ToString("N0")</td>
                                            <td class="text-end">$ @r.PrecioUnitario.ToString("N2")</td>
                                            <td class="text-end fw-bold text-dark">$ @r.Subtotal.ToString("N2")</td>
                                            <td class="pe-3 text-center">
                                                <span class="badge bg-light text-dark border">@r.Estado</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Bitácora y Notas Rápidas -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold text-secondary m-0">
                        <i class="bi bi-journal-text me-2 text-info"></i>Bitácora de Seguimiento (@Model.HistorialNotas.Count registros)
                    </h6>
                </div>
                <div class="card-body p-4">
                    <!-- Formulario para agregar nota rápida -->
                    <div class="input-group mb-4">
                        <input type="text" id="nuevaNotaInput" class="form-control" placeholder="Escribir una nota rápida de avance para esta orden..." />
                        <button class="btn btn-info text-white fw-semibold" type="button" onclick="agregarNotaRapida(@Model.Id)">
                            <i class="bi bi-send me-1"></i> Guardar Nota
                        </button>
                    </div>

                    <!-- Lista de notas en formato timeline -->
                    @if (!Model.HistorialNotas.Any())
                    {
                        <p class="text-muted small text-center py-3">No hay notas registradas en la bitácora aún.</p>
                    }
                    else
                    {
                        <div class="timeline ps-3 border-start border-2 border-light">
                            @foreach (var nota in Model.HistorialNotas)
                            {
                                <div class="mb-3 position-relative ps-3">
                                    <span class="position-absolute start-0 top-0 translate-middle-x bg-info rounded-circle" 
                                          style="width: 10px; height: 10px; margin-left: -1px; margin-top: 6px;"></span>
                                    <div class="small text-muted">@nota.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div>
                                    <div class="p-2 bg-light rounded-3 mt-1 text-secondary">
                                        @nota.Nota
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    async function agregarNotaRapida(ordenId) {
        const input = document.getElementById('nuevaNotaInput');
        const nota = input.value.trim();

        if (!nota) {
            alert('Por favor escribe el contenido de la nota.');
            return;
        }

        try {
            const resp = await fetch('/api/tecnico/bitacora', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    ordenId: ordenId,
                    nota: nota
                })
            });

            if (resp.ok) {
                location.reload();
            } else {
                const error = await resp.text();
                alert('Error al agregar nota: ' + error);
            }
        } catch (e) {
            alert('Error de conexión: ' + e);
        }
    }
</script>
}
