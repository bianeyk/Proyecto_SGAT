@model SGAT.Application.DTOs.Paginacion.PagedResult<SGAT.Application.DTOs.Equipo.EquipoDto>
@{
    ViewData["Title"] = "Equipos";
    var termino = ViewData["Termino"] as string;
    var estado = ViewData["Estado"] as string ?? "todos";
    var pagina = (int)(ViewData["Pagina"] ?? 1);
    var paginas = (int)(ViewData["TotalPaginas"] ?? 1);
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1>Equipos</h1><p class="text-muted mb-0">Administra los dispositivos y su relación con los clientes.</p></div>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Registrar equipo</a>
    </div>
    <form method="get" asp-action="Index" role="search" class="sg-buscador row g-2 mb-3">
        <div class="col-md-7">
            <label for="termino" class="visually-hidden">Buscar equipos</label>
            <input id="termino" name="termino" type="search" value="@termino" maxlength="100" class="form-control"
                   placeholder="Inicio de modelo, serial, cliente, documento, marca o categoría" />
        </div>
        <div class="col-md-3">
            <label for="estado" class="visually-hidden">Estado</label>
            <select id="estado" name="estado" class="form-select">
                <option value="todos" selected="@(estado == "todos")">Todos (@(Model.ActiveCount + Model.InactiveCount))</option>
                <option value="activo" selected="@(estado == "activo")">Activos (@Model.ActiveCount)</option>
                <option value="inactivo" selected="@(estado == "inactivo")">Inactivos (@Model.InactiveCount)</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2"><button class="btn btn-primary">Buscar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
    </form>
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Equipo</th><th>Cliente</th><th>Serial</th><th>Estado</th><th>Acciones</th></tr></thead>
                <tbody>
                @foreach (var equipo in Model.Items)
                {
                    <tr>
                        <td><strong>@equipo.Marca @equipo.Modelo</strong><div class="text-muted small">@equipo.Categoria</div></td>
                        <td>@equipo.Cliente<div class="text-muted small">@equipo.DocumentoCliente</div></td>
                        <td>@(equipo.Serial ?? "Sin serial")</td>
                        <td><span class="badge @(equipo.Activo ? "bg-success" : "bg-secondary")">@(equipo.Activo ? "Activo" : "Inactivo")</span></td>
                        <td class="text-nowrap"><a asp-action="Details" asp-route-id="@equipo.IdEquipo" class="btn btn-sm btn-outline-primary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@equipo.IdEquipo" class="btn btn-sm btn-outline-secondary">Editar</a></td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">No hay equipos en esta página. Revisa la búsqueda o vuelve al inicio.</td></tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted">Mostrando @Model.Items.Count de @Model.TotalCount resultados.</div>
    </div>
    <nav class="d-flex justify-content-center align-items-center gap-3 mt-3" aria-label="Paginación de equipos">
        @if (pagina > 1)
        {
            <a asp-action="Index" asp-route-termino="@termino" asp-route-estado="@estado" asp-route-pagina="@(pagina - 1)" class="btn btn-outline-secondary">Anterior</a>
        }
        <span>Página @pagina de @paginas</span>
        @if (pagina < paginas && pagina < 1000)
        {
            <a asp-action="Index" asp-route-termino="@termino" asp-route-estado="@estado" asp-route-pagina="@(pagina + 1)" class="btn btn-outline-secondary">Siguiente</a>
        }
    </nav>
</div>
