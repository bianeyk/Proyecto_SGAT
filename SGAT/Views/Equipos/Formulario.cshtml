@model SGAT.Web.ViewModels.Equipo.EquipoViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var editando = Model.IdEquipo > 0;
    ViewData["Title"] = editando ? "Editar equipo" : "Registrar equipo";
}
<div class="container py-4" style="max-width: 800px">
    <a asp-action="Index" class="text-decoration-none">← Equipos</a>
    <h1 class="mt-3">@ViewData["Title"]</h1>
    <form asp-action="@(editando ? "Edit" : "Create")" asp-route-id="@(editando ? Model.IdEquipo : (int?)null)" method="post" class="card shadow-sm mt-4">
        <div class="card-body p-4">
            <input asp-for="IdEquipo" type="hidden" />
            <input asp-for="Version" type="hidden" />
            <input asp-for="SerialGenerado" type="hidden" />
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            @if (!Model.TieneOrdenes)
            {
                <div class="mb-3">
                    <label for="buscarCliente" class="form-label">Buscar cliente por inicio de nombre o documento</label>
                    <div class="input-group">
                        <input id="buscarCliente" class="form-control" maxlength="100" placeholder="Escribe al menos 2 caracteres" />
                        <button type="button" id="buscarClienteBoton" class="btn btn-outline-primary" data-url="@Url.Action("BuscarClientes")">Buscar</button>
                    </div>
                    <div id="mensajeClientes" class="form-text" role="status" aria-live="polite">Se muestran hasta 20 coincidencias. Selecciona el cliente en la lista.</div>
                </div>
            }
            <div class="mb-3">
                <label asp-for="IdCliente" class="form-label"></label>
                <select asp-for="IdCliente" asp-items="@(new SelectList(Model.Clientes, "Id", "Nombre"))" class="form-select">
                    <option value="">Selecciona el cliente</option>
                </select>
                <span asp-validation-for="IdCliente" class="text-danger"></span>
                @if (Model.TieneOrdenes)
                {
                    <p class="form-text">El cliente se conserva porque el equipo tiene órdenes de servicio.</p>
                }
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="IdCategoriaDispositivo" class="form-label"></label>
                    <select asp-for="IdCategoriaDispositivo" asp-items="@(new SelectList(Model.Categorias, "Id", "Nombre"))" class="form-select"><option value="">Selecciona una categoría de dispositivo</option></select>
                    <span asp-validation-for="IdCategoriaDispositivo" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IdMarca" class="form-label"></label>
                    <select asp-for="IdMarca" asp-items="@(new SelectList(Model.Marcas, "Id", "Nombre"))" class="form-select"><option value="">Selecciona una marca</option></select>
                    <span asp-validation-for="IdMarca" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Modelo" class="form-label"></label>
                    <input asp-for="Modelo" class="form-control" maxlength="100" />
                    <span asp-validation-for="Modelo" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Serial" class="form-label"></label>
                    <input asp-for="Serial" class="form-control" maxlength="100" />
                    <span asp-validation-for="Serial" class="text-danger"></span>
                    <div class="form-text">Opcional. Si lo dejas vacío, SGAT generará un serial único automáticamente.</div>
                </div>
                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="255"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar equipo</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/equipos.js" asp-append-version="true"></script>
}
