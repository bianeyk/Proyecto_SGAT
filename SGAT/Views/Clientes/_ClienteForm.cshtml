@model SGAT.Web.ViewModels.Cliente.ClienteViewModel

@if (ViewData["EsEdicion"] is not true)
{
    <div class="mb-3">
        <label asp-for="NumDocumento" class="form-label"></label>
        <input asp-for="NumDocumento" class="form-control"
       inputmode="numeric"
       pattern="[0-9]*"
       oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
        <span asp-validation-for="NumDocumento" class="text-danger"></span>
    </div>
}
<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control"
           onkeydown="if(event.key === '*' || event.code === 'NumpadMultiply') event.preventDefault();"ayudame tambien con este por favor
           oninput="this.value = this.value.replace(/\*/g, '').replace(/[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑüÜ\s.'-]/g, '')" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Telefono" class="form-label"></label>
    <input asp-for="Telefono" class="form-control"
       inputmode="numeric"
       pattern="[0-9]*"
       oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
    <span asp-validation-for="Telefono" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Email" class="form-label">Correo Electrónico</label>
    <input asp-for="Email" type="email" class="form-control" placeholder="cliente@ejemplo.com"
           onkeydown="if(event.key === '*' || event.code === 'NumpadMultiply') event.preventDefault();"
           oninput="this.value = this.value.replace(/\*/g, '').trim();" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Direccion" class="form-label">Dirección</label>
    <input asp-for="Direccion" class="form-control" placeholder="Ej. Calle 45 # 12-34 Apto 301"
           onkeydown="if(event.key === '*' || event.code === 'NumpadMultiply') event.preventDefault();"
           oninput="this.value = this.value.replace(/\*/g, '').replace(/[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑüÜ\s#.,\/-]/g, '')" />
    <span asp-validation-for="Direccion" class="text-danger"></span>
</div>
<div class="form-check mb-3">
    <input asp-for="EsColaborador" class="form-check-input" />
    <label asp-for="EsColaborador" class="form-check-label"></label>
</div>
<div class="form-check mb-3">
    <input asp-for="Activo" class="form-check-input" />
    <label asp-for="Activo" class="form-check-label"></label>
</div>