@model IEnumerable<SGAT.Application.DTOs.Cliente.ClienteDto>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Clientes</h1>
        <a asp-action="Create" class="btn btn-primary">Crear cliente</a>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-sm-8 col-md-6">
            <input type="search" name="termino" value="@ViewData["Termino"]"
                   class="form-control" placeholder="Buscar por documento, nombre, correo o teléfono" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Documento</th>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.NumDocumento</td>
                        <td>@cliente.Nombre</td>
                        <td>@cliente.Telefono</td>
                        <td>@cliente.Email</td>
                        <td>
                            <span class="badge @(cliente.Activo ? "bg-success" : "bg-secondary")">
                                @(cliente.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-outline-primary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-outline-warning">Editar</a>
                            @if (cliente.Activo)
                            {
                                <a asp-action="Delete" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-outline-danger">Dar de baja</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center">No se encontraron clientes.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
