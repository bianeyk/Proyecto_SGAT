@model SGAT.Web.ViewModels.Cliente.ClienteViewModel

@{
    ViewData["Title"] = "Editar cliente";
    ViewData["EsEdicion"] = true;
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white"><h4 class="mb-0">Editar cliente</h4></div>
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.IdCliente" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="IdCliente" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="NumDocumento" class="form-label"></label>
                    <input value="@Model.NumDocumento" class="form-control" readonly />
                </div>
                <partial name="_ClienteForm" model="Model" />
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
